# Copy this file to .env and fill in your Tailscale details.
# Find IP:       tailscale ip -4
# Find hostname: tailscale status (first line shows machine name + domain)
TAILSCALE_IP=100.x.x.x
TS_HOSTNAME=mymachine.tail1234.ts.net
BACKEND_PORT=6942
JWT_SECRET=change-me-in-production
SEED_USERNAME=admin
SEED_PASSWORD=change-me
